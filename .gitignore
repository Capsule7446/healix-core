# OS metadata
.DS_Store

# Go build and test artifacts
/bin/
*.test
*.out
coverage.out

# Local environment and editor files
.env
.env.*
!.env.example
.vscode/
.claude/
.idea/

# Scan artefacts. Adversarial review runs are driven from the worktree root and
# leave their prompts and logs behind; one of those logs is 2MB.
/scan-*.log
/prompt-*.md
/run-scan*.bat

# Write-mode agent artefacts. Agents editing the worktree set their own GOCACHE
# to avoid fighting over the shared one, and a `> /dev/null` redirect on Windows
# creates a real file. The root .gitconfig is written by tooling and git never
# reads it — only .git/config, ~/.gitconfig, and /etc/gitconfig.
#
# This list only covers names already seen. A new agent will invent a new one,
# so it does not replace checking `git status` before staging, and never use
# `git add -A` while an agent is running.
/.codex/
/dev/
/.gitconfig
/tmp_gocache*/
/tmp_test.txt
